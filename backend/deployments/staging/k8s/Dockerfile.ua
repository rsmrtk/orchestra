# syntax=docker/dockerfile:1.4
# PRODUCTION-READY DOCKERFILE ДЛЯ GO BACKEND
# Архітектура: Multi-stage build з безпековим захистом
# Базовий образ: Distroless для мінімальної поверхні атаки
# Час збірки: ~2-3 хв перша збірка, ~5-10 сек кешовані пересбірки

# ============================================================================
# ЕТАП 1: BUILDER - Компіляція Go бінарника
# ============================================================================
FROM golang:1.25.4-alpine AS builder

# Встановлення залежностей для збірки
# ca-certificates: Потрібні для HTTPS запитів на етапі збірки
# git: Потрібний для приватних Go модулів (якщо є)
# tzdata: Для даних часових поясів (скопіюємо в runtime етап)
RUN apk add --no-cache ca-certificates git tzdata

# Встановлення робочої директорії
WORKDIR /build

# Увімкнення Go module proxy для швидшого, надійного завантаження залежностей
# GOPROXY: Публічний proxy з прямим fallback для приватних репозиторіїв
# GOSUMDB: База контрольних сум для безпекової перевірки
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org

# ============================================================================
# ОПТИМІЗАЦІЯ КЕШУВАННЯ ШАРІВ: Копіюємо go.mod/go.sum ПЕРШИМИ
# ЧОМУ: Залежності змінюються рідко (можливо раз на тиждень)
#       Вихідний код змінюється часто (кожен коміт)
#       Це розділення означає, що ми перезавантажуємо залежності тільки при зміні go.mod
# РЕЗУЛЬТАТ: 95% збірок використовують кешовані шари, заощаджуючи 2-3 хвилини на збірку
# ============================================================================
COPY go.mod go.sum ./

# Завантаження залежностей з cache mount для масивного прискорення
# --mount=type=cache: Зберігає /go/pkg/mod між збірками
# РЕЗУЛЬТАТ: Перше завантаження = 30с, наступні = 1с (з кешу)
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download && \
    go mod verify

# Копіювання вихідного коду (цей шар інвалідується при кожній зміні коду)
COPY . .

# ============================================================================
# КОНФІГУРАЦІЯ ЗБІРКИ: Статичний бінарник з оптимізаціями
# ============================================================================
# CGO_ENABLED=0: Збірка статичного бінарника (без динамічного зв'язування)
#   ЧОМУ: Може працювати на scratch/distroless (не потрібна libc)
#   КРИТИЧНО для мінімальних образів
#
# GOOS=linux GOARCH=amd64: Явна платформа (важливо для M1 Mac)
#   ЧОМУ: Запобігає "exec format error" при збірці на Mac, розгортанні на Linux
#
# -ldflags="-w -s": Видалення налагоджувальної інформації та таблиці символів
#   ЧОМУ: Зменшує розмір бінарника на 30-40% (напр., 20MB -> 13MB)
#   -w: Пропускає DWARF налагоджувальну інформацію
#   -s: Пропускає таблицю символів
#   КОМПРОМІС: Не можна використовувати налагоджувачі (gdb/dlv) на цьому бінарнику
#              Для staging/prod це прийнятно для зменшення розміру
#
# -trimpath: Видалення шляхів файлової системи з бінарника
#   ЧОМУ: Безпека (не витікають шляхи /home/username/project)
#         Відтворювані збірки (той самий код = той самий хеш бінарника)
#
# -o /app/server: Розташування вихідного бінарника
# ./cmd/server: Точка входу (main пакет)
# ============================================================================
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64 \
    go build \
        -ldflags="-w -s" \
        -trimpath \
        -o /app/server \
        ./cmd/server

# Перевірка, що бінарник статично зв'язаний (немає залежностей)
# Ця команда гарантує, що ми можемо запускати на мінімальних базових образах
RUN ldd /app/server 2>&1 | grep -q "not a dynamic executable" || \
    (echo "ПОМИЛКА: Бінарник не статично зв'язаний!" && exit 1)

# ============================================================================
# ЕТАП 2: RUNTIME - Мінімальний production образ
# ============================================================================
# Використання distroless замість scratch тому що:
# - Включає CA сертифікати (для HTTPS API викликів)
# - Включає tzdata (для перетворень часових поясів)
# - Включає /etc/passwd (для non-root користувача)
# - Все ще мінімальний: ~2MB базовий образ, нуль менеджера пакетів, нуль shell
#
# Альтернативні варіанти:
# - scratch: Абсолютний мінімум (0 байтів), використовуйте якщо немає потреби в HTTPS/timezone
# - alpine:3.20: ~5MB, включає shell (корисно для налагодження), менеджер пакетів
# - distroless/base: ~20MB, включає glibc (використовуйте якщо CGO_ENABLED=1)
FROM gcr.io/distroless/static-debian12:nonroot

# ============================================================================
# БЕЗПЕКОВИЙ ЗАХИСТ: Non-root користувач
# ============================================================================
# distroless:nonroot включає користувача "nonroot" з UID 65532
# ЧОМУ non-root КРИТИЧНО:
# 1. Уразливість виходу з контейнера: Якщо зловмисник виривається з контейнера,
#    вони отримують ті ж привілеї на хості. Root в контейнері = root на хості = повна компрометація
# 2. Kubernetes PodSecurityStandards: Починаючи з 2024+, кластери примушують
#    runAsNonRoot=true. Root контейнери будуть ВІДХИЛЕНІ.
# 3. Відповідність: SOC2, PCI-DSS, HIPAA всі вимагають принципу найменших привілеїв
# 4. Глибинна оборона: Навіть якщо додаток скомпрометований, зловмисник має обмежені привілеї
#
# Ця директива USER успадковується Kubernetes (якщо не перевизначена в pod spec)
USER nonroot:nonroot

# Встановлення робочої директорії
WORKDIR /app

# ============================================================================
# КОПІЮВАННЯ АРТЕФАКТІВ З BUILDER ЕТАПУ
# ============================================================================
# Копіювання скомпільованого бінарника з builder етапу
# --from=builder: Посилання на попередній етап
# --chown=nonroot:nonroot: Встановлення власності на non-root користувача
#   ЧОМУ: Запобігає помилкам прав доступу коли додаток намагається читати/писати файли
COPY --from=builder --chown=nonroot:nonroot /app/server /app/server

# Копіювання даних часових поясів (якщо ваш додаток використовує time.LoadLocation)
# Distroless включає це за замовчуванням, але явне копіювання якщо використовується scratch:
# COPY --from=builder --chown=nonroot:nonroot /usr/share/zoneinfo /usr/share/zoneinfo

# Копіювання CA сертифікатів (якщо ваш додаток робить HTTPS запити)
# Distroless включає це за замовчуванням, але явне копіювання якщо використовується scratch:
# COPY --from=builder --chown=nonroot:nonroot /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# ============================================================================
# ОПЦІЙНО: Копіювання міграцій або статичних файлів якщо потрібно
# ============================================================================
# COPY --from=builder --chown=nonroot:nonroot /build/migrations /app/migrations

# ============================================================================
# RUNTIME КОНФІГУРАЦІЯ
# ============================================================================
# Відкриття порту (ТІЛЬКИ ДОКУМЕНТАЦІЯ - не публікує порти фактично)
# Фактичне відображення портів налаштовується в Kubernetes Service
# Це документує, що додаток слухає на 8080
EXPOSE 8080

# Змінні середовища (можуть бути перевизначені в Kubernetes deployment)
# Це ТІЛЬКИ ЗНАЧЕННЯ ЗА ЗАМОВЧУВАННЯМ - чутливі значення приходять з ConfigMap/Secret
ENV GIN_MODE=release \
    PORT=8080

# ============================================================================
# HEALTH CHECK (Kubernetes використовує liveness/readiness проби, але це документує endpoint)
# ============================================================================
# Kubernetes не використовує Dockerfile HEALTHCHECK, але це корисна документація
# Налаштуйте в K8s deployment.yaml замість цього:
#   livenessProbe:
#     httpGet:
#       path: /health
#       port: 8080
#     initialDelaySeconds: 10
#     periodSeconds: 30
# HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
#     CMD ["/app/server", "--healthcheck"]

# ============================================================================
# ENTRYPOINT: Запуск додатку
# ============================================================================
# Використання ENTRYPOINT (не CMD) для ясності
# ENTRYPOINT: Завжди виконується, не може бути перевизначений (без --entrypoint)
# CMD: Може бути перевизначений аргументами docker run
#
# Exec форма (JSON масив) переважніша над shell формою:
# ДОБРЕ: ["./server"]  -> Працює як PID 1, отримує SIGTERM безпосередньо
# ПОГАНО: "./server"   -> Працює через /bin/sh, SIGTERM йде до shell спочатку
#
# ЧОМУ PID 1 важливо:
# - Kubernetes надсилає SIGTERM до PID 1 для плавного завершення
# - Якщо shell є PID 1, він може не переадресувати сигнал до додатку
# - Результат: Додаток не завершується плавно, з'єднання обриваються
#
# ПЛАВНЕ ЗАВЕРШЕННЯ В GO КОДІ:
# Ваш додаток повинен обробляти SIGTERM:
#   quit := make(chan os.Signal, 1)
#   signal.Notify(quit, syscall.SIGTERM, syscall.SIGINT)
#   <-quit
#   ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
#   defer cancel()
#   if err := srv.Shutdown(ctx); err != nil {
#       log.Fatal("Сервер примусово завершено:", err)
#   }
ENTRYPOINT ["/app/server"]

# ============================================================================
# ІНСТРУКЦІЇ ПО ЗБІРЦІ ТА РОЗГОРТАННЮ
# ============================================================================
#
# ЛОКАЛЬНА ЗБІРКА:
#   docker build -t orchestra-backend:local -f deployments/staging/k8s/Dockerfile .
#
# ЗБІРКА З GIT SHA ТЕГ (рекомендовано для production):
#   GIT_SHA=$(git rev-parse --short HEAD)
#   docker build -t orchestra-backend:${GIT_SHA} -f deployments/staging/k8s/Dockerfile .
#
# ЗАПУСК ЛОКАЛЬНО (для тестування):
#   docker run --rm -p 8080:8080 \
#     -e DATABASE_URL=postgres://user:pass@host:5432/db \
#     orchestra-backend:local
#
# СКАНУВАННЯ БЕЗПЕКИ (запустити перед розгортанням):
#   trivy image orchestra-backend:${GIT_SHA}
#   # Повинно показувати НУЛЬ HIGH або CRITICAL вразливостей
#
# PUSH В REGISTRY:
#   docker tag orchestra-backend:${GIT_SHA} gcr.io/your-project/orchestra-backend:${GIT_SHA}
#   docker push gcr.io/your-project/orchestra-backend:${GIT_SHA}
#
# РОЗГОРТАННЯ В KUBERNETES:
#   kubectl set image deployment/orchestra-backend \
#     backend=gcr.io/your-project/orchestra-backend:${GIT_SHA} \
#     -n staging
#
# ============================================================================
# PRODUCTION ЧЕКЛІСТ
# ============================================================================
# [ ] Multi-stage збірка (build + runtime)
# [ ] Статичний бінарник (CGO_ENABLED=0, перевірено з ldd)
# [ ] Non-root користувач (USER nonroot)
# [ ] Мінімальний базовий образ (distroless/static)
# [ ] Оптимізоване кешування шарів (go.mod перед вихідним кодом)
# [ ] .dockerignore налаштований
# [ ] Немає захардкоджених секретів (перевірити з: docker history image:tag)
# [ ] Сканування безпеки пройдено (trivy/snyk/clair)
# [ ] Образ тегований з git SHA (не :latest)
# [ ] Плавне завершення реалізовано (SIGTERM обробник в коді)
# [ ] Health checks визначені в K8s deployment
# [ ] Resource limits встановлені в K8s (requests/limits для CPU/пам'яті)
# [ ] Протестовано в staging перед prod
#
# ============================================================================
# ВИРІШЕННЯ ПРОБЛЕМ
# ============================================================================
#
# ПОМИЛКА: "exec format error"
#   ПРИЧИНА: Бінарник зібраний для неправильної архітектури (напр., ARM на M1 Mac, розгорнуто на AMD64 Linux)
#   ВИПРАВЛЕННЯ: Переконайтеся що GOOS=linux GOARCH=amd64 в build етапі
#
# ПОМИЛКА: "permission denied" коли контейнер стартує
#   ПРИЧИНА: Бінарник не виконуваний, або non-root користувач не може отримати доступ до файлів
#   ВИПРАВЛЕННЯ: Переконайтеся COPY --chown=nonroot:nonroot, або RUN chmod +x /app/server
#
# ПОМИЛКА: Контейнер падає негайно
#   НАЛАГОДЖЕННЯ: Запустіть з доступом до shell (тільки для налагодження):
#     docker run --rm -it --entrypoint /bin/sh alpine:3.20
#     # Потім перевірте бінарник, перевірте ldd, і т.д.
#
# ПОМИЛКА: "x509: certificate signed by unknown authority"
#   ПРИЧИНА: Відсутні CA сертифікати (поширене з scratch базою)
#   ВИПРАВЛЕННЯ: Використовуйте distroless/static (включає CA сертифікати) або скопіюйте з builder:
#     COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
#
# ПОМИЛКА: Додаток не може підключитися до бази даних
#   ПРИЧИНА: DATABASE_URL не встановлений, або network policy блокує з'єднання
#   НАЛАГОДЖЕННЯ: Перевірте змінні середовища в K8s:
#     kubectl exec -it pod-name -- env | grep DATABASE
#
# ============================================================================
# ОПТИМІЗАЦІЯ ПРОДУКТИВНОСТІ
# ============================================================================
#
# ПОТОЧНИЙ ЧАС ЗБІРКИ:
# - Перша збірка (без кешу): ~2-3 хвилини
# - З кешем шарів: ~5-10 секунд
# - З кешем go mod: ~1-2 секунди
#
# ПОДАЛЬШІ ОПТИМІЗАЦІЇ:
# 1. Використовуйте приватний GOPROXY (Athens/Artifactory) для швидших, надійних завантажень
# 2. Використовуйте Docker BuildKit cache backend (registry або S3):
#      docker buildx build --cache-from=type=registry,ref=image:cache ...
# 3. Паралельні збірки якщо декілька бінарників:
#      RUN go build ./cmd/server & go build ./cmd/worker & wait
# 4. Використовуйте multi-platform збірки для ARM + AMD64:
#      docker buildx build --platform linux/amd64,linux/arm64 ...
#
# РОЗМІР ОБРАЗУ:
# - Builder етап: ~800MB (golang:1.25-alpine + залежності)
# - Runtime етап: ~15MB (2MB distroless + 13MB бінарник)
# - Оптимізація: Розмір бінарника може бути зменшений далі з UPX компресією
#   (але додає overhead декомпресії в runtime, рідко варто того)
#
# ============================================================================
# АНАЛІЗ ВАРТОСТІ (приклад для GKE з 10 репліками)
# ============================================================================
#
# Вплив розміру образу:
# - Великий образ (500MB): 10 нод × 500MB × $0.10/GB/місяць = $5/місяць зберігання
#                          10 pull/день × 500MB × $0.12/GB egress = $18/місяць
# - Малий образ (15MB): 10 нод × 15MB × $0.10/GB/місяць = $0.15/місяць зберігання
#                       10 pull/день × 15MB × $0.12/GB egress = $0.54/місяць
#
# ЗАОЩАДЖЕННЯ: $22.31/місяць на сервіс
# При 50 мікросервісах: $1,115/місяць = $13,380/рік заощаджено
#
# Ось чому FAANG компанії одержимі розміром образів.
#
# ============================================================================
